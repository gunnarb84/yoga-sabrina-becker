{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "sabrina-becker/yoga",
    "type": "project",
    "description": "Yoga Webseite mit CMS und Verwaltung",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.4",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Yoga\\Modules\\Webseite\\": "../modules/Webseite/",
            "Yoga\\Modules\\Verwaltung\\": "../modules/Verwaltung/",
            "Yoga\\Platform\\": "../platform/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Yoga\\Modules\\Webseite\\Tests\\": "../modules/Webseite/tests/",
            "Yoga\\Modules\\Verwaltung\\Tests\\": "../modules/Verwaltung/tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "php artisan package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": ["*"]
        }
    },
    "config": {
        "vendor-dir": "../vendor",
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
